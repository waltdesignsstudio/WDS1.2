{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document stored under users/{uid} for Corporate and Admin users",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "corporateUserId": {
          "type": "string",
          "description": "Unique corporate Sales WDS User ID identifier (e.g. WDS-4827)",
          "pattern": "^WDS-[0-9]{4,6}$"
        },
        "adminUserId": {
          "type": "string",
          "description": "Unique Admin User ID identifier (e.g. ADM-101)",
          "maxLength": 40
        },
        "name": {
          "type": "string",
          "description": "Full name of the user",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Email address of the user",
          "format": "email",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number",
          "minLength": 6,
          "maxLength": 25
        },
        "location": {
          "type": "string",
          "description": "Location or branch of the user",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "description": "Access control role of the user (corporate or admin)",
          "enum": ["corporate", "admin"]
        },
        "corporateRole": {
          "type": "string",
          "description": "Corporate designation: Asst. Sales Manager, Senior Sales Manager, or Executive",
          "maxLength": 80
        },
        "income": {
          "type": "number",
          "description": "Calculated or reported corporate income in INR"
        },
        "progress": {
          "type": "number",
          "description": "Target achievement progress percentage (0 - 100)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document last updated server timestamp"
        }
      },
      "required": ["uid", "name", "email", "phone", "role"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily corporate attendance record submitted by employees and approved/rejected by Admin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique attendance document ID"
        },
        "employeeUid": {
          "type": "string",
          "description": "Firebase Auth UID of the employee submitting attendance"
        },
        "employeeCode": {
          "type": "string",
          "description": "Corporate employee code (e.g. WDS-4827)"
        },
        "employeeName": {
          "type": "string",
          "description": "Full name of the employee"
        },
        "date": {
          "type": "string",
          "description": "Date of attendance in YYYY-MM-DD format"
        },
        "todayWorkHours": {
          "type": "number",
          "description": "Logged work hours for the day (e.g. 8)"
        },
        "expectedClients": {
          "type": "number",
          "description": "Number of client meetings/leads expected"
        },
        "status": {
          "type": "string",
          "description": "Approval status of the attendance submission",
          "enum": ["pending", "approved", "rejected"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of attendance submission"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of status update"
        }
      },
      "required": ["employeeUid", "employeeCode", "employeeName", "date", "todayWorkHours", "expectedClients", "status"]
    },
    "WdsLookup": {
      "title": "WdsLookup",
      "description": "Lookup index mapping unique corporate WDS IDs to user emails for ID-based lookup",
      "type": "object",
      "properties": {
        "corporateUserId": {
          "type": "string",
          "description": "Unique Corporate WDS ID (e.g. WDS-4827)",
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "description": "Email address tied to the WDS ID",
          "format": "email",
          "maxLength": 120
        },
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["corporateUserId", "email", "uid"]
    },
    "DailyReportItem": {
      "title": "DailyReportItem",
      "description": "Daily data lead / client report created by Admin and assigned to a corporate employee",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique daily report document ID"
        },
        "sNo": {
          "type": "number",
          "description": "Serial number of the report entry"
        },
        "name": {
          "type": "string",
          "description": "Client or Lead name",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "description": "Client email address",
          "format": "email",
          "maxLength": 120
        },
        "number": {
          "type": "string",
          "description": "Client contact phone number",
          "maxLength": 40
        },
        "location": {
          "type": "string",
          "description": "Client or project location",
          "maxLength": 120
        },
        "requirement": {
          "type": "string",
          "description": "Design or business requirement details",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "description": "Lead/report status (e.g. Assigned, In Progress, Contacted, Closed)",
          "maxLength": 50
        },
        "assignedEmployeeUid": {
          "type": "string",
          "description": "Firebase Auth UID of the assigned corporate employee",
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "assignedEmployeeCode": {
          "type": "string",
          "description": "Corporate Employee ID (e.g. WDS-4827)",
          "maxLength": 40
        },
        "assignedEmployeeName": {
          "type": "string",
          "description": "Full name of the assigned employee",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["name", "email", "number", "location", "requirement", "status", "assignedEmployeeUid"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profile collection containing Corporate and Admin profiles keyed by Auth UID"
    },
    "/attendance/{attendanceId}": {
      "schema": {
        "$ref": "#/entities/AttendanceRecord"
      },
      "description": "Collection of employee attendance submissions managed by Admin"
    },
    "/daily_reports/{reportId}": {
      "schema": {
        "$ref": "#/entities/DailyReportItem"
      },
      "description": "Collection of Daily Data Reports created by Admin and assigned to Corporate employees by Firebase UID"
    },
    "/wds_lookup/{corporateUserId}": {
      "schema": {
        "$ref": "#/entities/WdsLookup"
      },
      "description": "Index mapping WDS IDs to email addresses for dual lookup"
    }
  }
}
