{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document stored under users/{uid} for Corporate and Admin users",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Full name of the user",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Email address of the user",
          "format": "email",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number",
          "minLength": 6,
          "maxLength": 25
        },
        "location": {
          "type": "string",
          "description": "Location or branch of the user",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "description": "Access control role of the user (corporate or admin)",
          "enum": ["corporate", "admin"]
        },
        "corporateRole": {
          "type": "string",
          "description": "Corporate designation: Asst. Sales Manager, Senior Sales Manager, or Executive",
          "maxLength": 80
        },
        "avlId": {
          "type": "string",
          "description": "Unique corporate Sales AVL ID identifier",
          "maxLength": 40
        },
        "income": {
          "type": "number",
          "description": "Calculated or reported corporate income in INR"
        },
        "progress": {
          "type": "number",
          "description": "Target achievement progress percentage (0 - 100)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document last updated server timestamp"
        }
      },
      "required": ["uid", "name", "email", "phone", "role"]
    },
    "AvlLookup": {
      "title": "AvlLookup",
      "description": "Lookup index mapping unique corporate AVL IDs to user emails for ID-based login",
      "type": "object",
      "properties": {
        "avlId": {
          "type": "string",
          "description": "Unique Corporate AVL ID",
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "description": "Email address tied to the AVL ID",
          "format": "email",
          "maxLength": 120
        },
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["avlId", "email", "uid"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profile collection containing Corporate and Admin profiles keyed by Auth UID"
    },
    "/avl_lookup/{avlId}": {
      "schema": {
        "$ref": "#/entities/AvlLookup"
      },
      "description": "Index mapping AVL IDs to email addresses for dual login support"
    }
  }
}
