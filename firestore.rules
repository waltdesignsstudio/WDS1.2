rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Zero-Trust Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Dynamic Admin Gate: Checks Firestore document role or primary system admin email
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "priyanshukumarjha604@gmail.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Entity Schema Validation Blueprint for User Profiles
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'phone', 'role']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.email is string && data.email.size() <= 120 &&
        data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 25 &&
        data.role in ['corporate', 'admin'] &&
        (!('corporateUserId' in data) || (data.corporateUserId is string && data.corporateUserId.size() <= 40)) &&
        (!('adminUserId' in data) || (data.adminUserId is string && data.adminUserId.size() <= 40)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 100)) &&
        (!('corporateRole' in data) || (data.corporateRole is string && data.corporateRole.size() <= 80)) &&
        (!('income' in data) || (data.income is number)) &&
        (!('progress' in data) || (data.progress is number)) &&
        (!('createdAt' in data) || (data.createdAt is timestamp || data.createdAt is string)) &&
        (!('updatedAt' in data) || (data.updatedAt is timestamp || data.updatedAt is string));
    }

    // User Profile Documents: /users/{uid}
    match /users/{uid} {
      // Single Document Read (Get): Only the user themselves OR an authorized Admin
      allow get: if isSignedIn() && isValidId(uid) && (
        request.auth.uid == uid || isAdmin()
      );

      // List Queries: Only Admin can list all; Corporate users can only query their own record
      allow list: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );

      // Document Creation:
      // 1. Admin can create any Corporate or Admin account document
      // 2. Initial or newly registering Admin creates their own admin profile
      allow create: if isSignedIn() && isValidId(uid) && isValidUserProfile(incoming()) && (
        isAdmin() ||
        (request.auth.uid == uid && incoming().uid == request.auth.uid && incoming().role == 'admin')
      );

      // Document Update:
      // 1. Corporate user can update own profile BUT CANNOT escalate role or alter immutable fields (corporateUserId, createdAt)
      // 2. Admin can update corporate metrics (income, progress)
      allow update: if isSignedIn() && isValidId(uid) && isValidUserProfile(incoming()) && (
        (
          request.auth.uid == uid &&
          incoming().uid == existing().uid &&
          incoming().role == existing().role && // Anti-privilege escalation
          (!('corporateUserId' in existing()) || incoming().corporateUserId == existing().corporateUserId) &&
          (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        ) ||
        isAdmin()
      );

      // Deletion: Admin only
      allow delete: if isSignedIn() && isValidId(uid) && isAdmin();
    }

    // WDS Lookup Index: /wds_lookup/{corporateUserId} (For WDS-XXXX ID dual-login)
    match /wds_lookup/{corporateUserId} {
      // Allows looking up email by Corporate User ID during login
      allow get: if isValidId(corporateUserId);
      allow list: if isSignedIn() && isAdmin();

      // Only Admin or authenticated creator can write lookup entry
      allow create, update: if isSignedIn() && isValidId(corporateUserId) && (
        isAdmin() || incoming().uid == request.auth.uid
      );

      allow delete: if isSignedIn() && isValidId(corporateUserId) && isAdmin();
    }
  }
}
