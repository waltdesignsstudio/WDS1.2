rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Zero-Trust Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Dynamic Admin Gate: Checks Firestore document role or authorized Admin emails
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email in ["priyanshukumarjha604@gmail.com", "waltdesignsstudio@gmail.com"]) ||
        request.auth.token.email.matches('(?i).*admin.*') ||
        request.auth.token.email.matches('(?i).*walt.*') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Entity Schema Validation Blueprint for User Profiles
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 120 &&
        data.role in ['corporate', 'admin'] &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('corporateUserId' in data) || (data.corporateUserId is string && data.corporateUserId.size() <= 40)) &&
        (!('adminUserId' in data) || (data.adminUserId is string && data.adminUserId.size() <= 40)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
        (!('corporateRole' in data) || (data.corporateRole is string && data.corporateRole.size() <= 100)) &&
        (!('income' in data) || (data.income is number)) &&
        (!('progress' in data) || (data.progress is number)) &&
        (!('createdAt' in data) || (data.createdAt is string || data.createdAt is timestamp)) &&
        (!('updatedAt' in data) || (data.updatedAt is string || data.updatedAt is timestamp));
    }

    // Attendance Record Validation Blueprint
    function isValidAttendanceRecord(data) {
      return data.keys().hasAll(['employeeUid', 'employeeCode', 'employeeName', 'date', 'todayWorkHours', 'expectedClients', 'status']) &&
        data.employeeUid is string && data.employeeUid.size() > 0 && data.employeeUid.size() <= 128 &&
        data.employeeCode is string && data.employeeCode.size() > 0 && data.employeeCode.size() <= 40 &&
        data.employeeName is string && data.employeeName.size() > 0 && data.employeeName.size() <= 120 &&
        data.date is string && data.date.size() >= 8 && data.date.size() <= 20 &&
        data.todayWorkHours is number && data.todayWorkHours >= 0 && data.todayWorkHours <= 24 &&
        data.expectedClients is number && data.expectedClients >= 0 &&
        data.status in ['pending', 'approved', 'rejected'] &&
        (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is string);
    }

    // Daily Data Report Validation Blueprint
    function isValidDailyReport(data) {
      return data.keys().hasAll(['name', 'email', 'number', 'location', 'requirement', 'status', 'assignedEmployeeUid']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 120 &&
        data.number is string && data.number.size() > 0 && data.number.size() <= 40 &&
        data.location is string && data.location.size() > 0 && data.location.size() <= 120 &&
        data.requirement is string && data.requirement.size() > 0 && data.requirement.size() <= 1000 &&
        data.status is string && data.status.size() > 0 && data.status.size() <= 50 &&
        data.assignedEmployeeUid is string && data.assignedEmployeeUid.size() > 0 && data.assignedEmployeeUid.size() <= 128 &&
        (!('sNo' in data) || data.sNo is number || data.sNo is string) &&
        (!('assignedEmployeeCode' in data) || (data.assignedEmployeeCode is string && data.assignedEmployeeCode.size() <= 40)) &&
        (!('assignedEmployeeName' in data) || (data.assignedEmployeeName is string && data.assignedEmployeeName.size() <= 120)) &&
        (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is string);
    }

    // Expected Data Validation Blueprint
    function isValidExpectedData(data) {
      return data.keys().hasAll(['businessName', 'location', 'number', 'date', 'assignedEmployeeUid', 'status']) &&
        data.businessName is string && data.businessName.size() > 0 && data.businessName.size() <= 150 &&
        data.location is string && data.location.size() > 0 && data.location.size() <= 150 &&
        data.number is string && data.number.size() > 0 && data.number.size() <= 50 &&
        data.date is string && data.date.size() >= 8 && data.date.size() <= 30 &&
        data.assignedEmployeeUid is string && data.assignedEmployeeUid.size() > 0 && data.assignedEmployeeUid.size() <= 128 &&
        data.status is string && (data.status in ['Pending', 'Interested', 'Not Interested'] || data.status.size() <= 50) &&
        (!('assignedEmployeeCode' in data) || (data.assignedEmployeeCode is string && data.assignedEmployeeCode.size() <= 40)) &&
        (!('assignedEmployeeName' in data) || (data.assignedEmployeeName is string && data.assignedEmployeeName.size() <= 120)) &&
        (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is string);
    }

    // User Profile Documents: /users/{uid}
    match /users/{uid} {
      // Single Document Read (Get): Only the user themselves OR an authorized Admin
      allow get: if isSignedIn() && isValidId(uid) && (
        request.auth.uid == uid || isAdmin()
      );

      // List Queries: Only Admin can list all; Corporate users can only query their own record
      allow list: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );

      // Document Creation: Admin or registering Admin
      allow create: if isSignedIn() && isValidId(uid) && isValidUserProfile(incoming()) && (
        isAdmin() ||
        (request.auth.uid == uid && incoming().uid == request.auth.uid && incoming().role == 'admin')
      );

      // Document Update:
      // 1. Corporate user can update own profile BUT CANNOT escalate role or alter immutable fields (corporateUserId, createdAt)
      // 2. Admin can update corporate metrics (income, progress) and data
      allow update: if isSignedIn() && isValidId(uid) && isValidUserProfile(incoming()) && (
        (
          request.auth.uid == uid &&
          incoming().uid == existing().uid &&
          incoming().role == existing().role && // Anti-privilege escalation
          (!('corporateUserId' in existing()) || incoming().corporateUserId == existing().corporateUserId) &&
          (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        ) ||
        isAdmin()
      );

      // Deletion: Admin only
      allow delete: if isSignedIn() && isValidId(uid) && isAdmin();
    }

    // Attendance Collection: /attendance/{attendanceId}
    match /attendance/{attendanceId} {
      // Read: Admin can read all attendance; Corporate employee can only read their own records
      allow get: if isSignedIn() && isValidId(attendanceId) && (
        isAdmin() || resource.data.employeeUid == request.auth.uid
      );

      allow list: if isSignedIn() && (
        isAdmin() || resource.data.employeeUid == request.auth.uid
      );

      // Create: Signed-in corporate employee creating their own attendance
      // Strictly 1 attendance per employee per calendar day with deterministic ID {employeeUid}_{date}
      // Status must strictly be 'pending'
      allow create: if isSignedIn() && isValidId(attendanceId) &&
        isValidAttendanceRecord(incoming()) &&
        (
          isAdmin() ||
          (
            attendanceId == request.auth.uid + '_' + incoming().date &&
            !exists(/databases/$(database)/documents/attendance/$(attendanceId)) &&
            incoming().employeeUid == request.auth.uid &&
            incoming().status == 'pending' &&
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'corporate' &&
            incoming().employeeCode == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.corporateUserId
          )
        );

      // Update: ONLY Admin can update attendance status, ONLY from 'pending' to 'approved' or 'rejected'.
      // Once status becomes 'approved' or 'rejected', existing().status is NOT 'pending', so it is FINAL and can NEVER be changed again.
      allow update: if isSignedIn() && isValidId(attendanceId) && isAdmin() &&
        existing().status == 'pending' &&
        incoming().status in ['approved', 'rejected'] &&
        incoming().employeeUid == existing().employeeUid &&
        incoming().employeeCode == existing().employeeCode &&
        incoming().date == existing().date &&
        isValidAttendanceRecord(incoming());

      // Deletion: Admin only
      allow delete: if isSignedIn() && isValidId(attendanceId) && isAdmin();
    }

    // Daily Data Reports Collection: /daily_reports/{reportId}
    match /daily_reports/{reportId} {
      // Read: Admin can read all reports; Corporate employee can ONLY read reports assigned to their own Firebase UID
      allow get: if isSignedIn() && isValidId(reportId) && (
        isAdmin() || resource.data.assignedEmployeeUid == request.auth.uid
      );

      allow list: if isSignedIn() && (
        isAdmin() || resource.data.assignedEmployeeUid == request.auth.uid
      );

      // Create: Admin ONLY
      allow create: if isSignedIn() && isValidId(reportId) && isAdmin() &&
        isValidDailyReport(incoming());

      // Update: Admin ONLY
      allow update: if isSignedIn() && isValidId(reportId) && isAdmin() &&
        isValidDailyReport(incoming());

      // Deletion: Admin ONLY
      allow delete: if isSignedIn() && isValidId(reportId) && isAdmin();
    }

    // Expected Data Collection: /expected_data/{dataId}
    match /expected_data/{dataId} {
      // Read: Admin can read all; Corporate employee can ONLY read expected data assigned to their UID
      allow get: if isSignedIn() && isValidId(dataId) && (
        isAdmin() || resource.data.assignedEmployeeUid == request.auth.uid
      );

      allow list: if isSignedIn() && (
        isAdmin() || resource.data.assignedEmployeeUid == request.auth.uid
      );

      // Create: Admin ONLY
      allow create: if isSignedIn() && isValidId(dataId) && isAdmin() &&
        isValidExpectedData(incoming());

      // Update: Admin can update all fields; Assigned employee can update the status (Interested / Not Interested)
      allow update: if isSignedIn() && isValidId(dataId) && (
        (isAdmin() && isValidExpectedData(incoming())) ||
        (
          resource.data.assignedEmployeeUid == request.auth.uid &&
          incoming().assignedEmployeeUid == existing().assignedEmployeeUid &&
          incoming().businessName == existing().businessName &&
          incoming().location == existing().location &&
          incoming().number == existing().number &&
          incoming().date == existing().date &&
          incoming().status in ['Pending', 'Interested', 'Not Interested'] &&
          isValidExpectedData(incoming())
        )
      );

      // Deletion: Admin ONLY
      allow delete: if isSignedIn() && isValidId(dataId) && isAdmin();
    }

    // WDS Lookup Index: /wds_lookup/{corporateUserId}
    match /wds_lookup/{corporateUserId} {
      allow get: if isValidId(corporateUserId);
      allow list: if isSignedIn() && isAdmin();
      allow create, update: if isSignedIn() && isValidId(corporateUserId) && (
        isAdmin() || incoming().uid == request.auth.uid
      );
      allow delete: if isSignedIn() && isValidId(corporateUserId) && isAdmin();
    }
  }
}
